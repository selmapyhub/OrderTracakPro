<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme without standard ActionBar for full-screen webview experience -->
    <style name="Theme.OrderTrackPro" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color matching web navbar -->
        <item name="colorPrimary">@color/primary_navy</item>
        <item name="colorPrimaryVariant">@color/primary_navy</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Status bar color -->
        <item name="android:statusBarColor">@color/primary_navy</item>
        <item name="android:navigationBarColor">@color/primary_navy</item>
    </style>
</resources>
